<!-- priting all listing data -->
 <div class="row mt-3">
    <div class="col-8 offset-3">
<% layout("/layouts/boilerplate")%> <!-- it is templating i.e is boilerplate done by ejs-mate -->

    <h3><%= listing.title %></h3>
    <br>
</div>
    <div class="card col-6 offset-3 show-card listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="...">
        <div class="card-body">
          <p class="card-text">Owned by <i><%= listing.owner.username %></i></p><br>
          <p class="card-text"><%= listing.description %></p><br>
          
           <!--  price with tax breakdown -->
           <p class="card-text">&#8377; <%= listing.price.toLocaleString("en-IN") %> / night</p>
           <p class="card-text">GST (<%= listing.taxRate %>%): 
               &#8377; <%= Math.round(listing.price * listing.taxRate / 100).toLocaleString("en-IN") %>
           </p>
           <p class="card-text"><b>Total: 
               &#8377; <%= Math.round(listing.price * (1 + listing.taxRate / 100)).toLocaleString("en-IN") %>
           </b></p><br>
          
          <!-- <p class="card-text"> &#8377; <%= listing.price.toLocaleString("en-IN") %></p><br> -->
          <p class="card-text">  <%= listing.location %></p><br>
          <p class="card-text">  <%= listing.country %></p><br>
        </div>      
    </div>
</div>
    <br/>         

    <% if(currUser && listing.owner._id.equals(currUser._id)){ %>
    <div class="btns">
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>
   

    <form method="POST" action="/listings/<%= listing._id%>?_method=DELETE">
    <button class="btn btn-dark offset-3">Delete</button>
        </form> 
</div>
<% } %>

<div class="col-8 offset-3 mb-3">
    <% if(currUser){ %>
  <h4>Leave a Review</h4>
  <form 
    action="/listings/<%= listing.id %>/reviews" 
    method="POST" 
    novalidate 
    class="needs-validation"
    >   <!--to make the form workable -->
    

    <div class="mb-3 mt-3">
      <label class="form-label">Rating</label>
    <fieldset class="starability-slot">
      <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
      <input type="radio" id="first-rate1" name="review[rating]" value="1" />
      <label for="first-rate1" title="Terrible">1 star</label>
      <input type="radio" id="first-rate2" name="review[rating]" value="2" />
      <label for="first-rate2" title="Not good">2 stars</label>
      <input type="radio" id="first-rate3" name="review[rating]" value="3" />
      <label for="first-rate3" title="Average">3 stars</label>
      <input type="radio" id="first-rate4" name="review[rating]" value="4" />
      <label for="first-rate4" title="Very good">4 stars</label>
      <input type="radio" id="first-rate5" name="review[rating]" value="5" />
      <label for="first-rate5" title="Amazing">5 stars</label>
    </fieldset>
     </div>
    <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comment</label>
        <textarea 
           name="review[comment]" 
           id="comment" 
           cols="30" 
           rows="5" 
           class="form-control"
           required 
           ></textarea>
           <div class="invalid-feedback">Please add some comments for review</div>
    </div>
    
    <button class="btn btn-outline-dark">Submit</button>
  
  </form>
  <hr/>
<% } %>


<% if(listing.reviews.length >0) { %>
<div class="row">
  <p><b>All Reviews</b></p>
  <% for(review of listing.reviews){ %>
  <div class="card col-5 ms-3 mb-3">
    <div class="card-body">
      <h5 class="card-title">@<%= review.author.username %></h5>
      <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
      <p class="card-text"><%= review.comment %></p><br/>
    </div>
   <form 
      class="mb-3" 
      method="POST" 
      action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">  <!-- when button is get click then method:POST request will go post request reach to action , and in action we send delete request from method overide ?_method=DELETE -->
      
      <button class="btn btn-sm btn-dark ">Delete</button>
    </form>
  </div>
  <% } %>
</div>
<% } %>
</div>  

<!-- map -->
<div class="row mt-3">
  <div class="col-8 offset-3">
<h3>Location</h3>
<div id="map" 
     style="height:300px; width: 100%;"
     data-coordinates='<%= listing.geometry ? JSON.stringify(listing.geometry.coordinates) : "[]" %>'>
</div>
</div>
</div>
    <script>
      const mapDiv = document.getElementById("map");
    
      if(mapDiv && mapDiv.dataset.coordinates){
          const coordinates = JSON.parse(mapDiv.dataset.coordinates);
    
          if(coordinates.length === 2){
              const map = L.map("map").setView(
                  [coordinates[1], coordinates[0]], // Leaflet uses [lat, lng]
                  9
              );
    
              L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                  attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
              }).addTo(map);
    
              L.marker([coordinates[1], coordinates[0]])
                  .addTo(map)
                  .bindPopup("<b>Exact location provided after booking!</b>")
                  .openPopup();
          }
      }
    </script>



